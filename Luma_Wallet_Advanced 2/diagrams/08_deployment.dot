digraph Deployment {
 graph [label="DEPLOYMENT — Luma Wallet on Render",labelloc=t,fontsize=22,fontname="DejaVu Sans",ranksep=.9,pad=.5,bgcolor="white"];
 node [shape=box,style="rounded",fontname="DejaVu Sans",fontsize=13,margin=".22,.14",color="#222222"];
 edge [fontname="DejaVu Sans",fontsize=11,color="#222222"];
 dev [label="Developer\nGitHub repository"];
 render [label="Cloud: Render Static Site\nHTML + CSS + JS via HTTPS"];
 browser [label="Client browser\nApp UI + localStorage"];
